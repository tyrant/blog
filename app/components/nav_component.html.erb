<nav class="bg-white border-gray-200 fixed top-0 w-full z-50 shadow-lg" data-controller="nav">

  <div class="flex justify-center items-center w-full bg-cyan-900 text-cyan-300 hover:text-cyan-100 duration-200"
       data-nav-target="landingDiv">
    <%= link_to landing_index_path,
                class: "p-2 my-auto text-sm font-bold" do %>
      Flirts GALORE: read <em>The Knights of Raw Phwoar</em> FREE omg
    <% end %>
    <svg xmlns="http://www.w3.org/2000/svg" 
         fill="none" 
         viewBox="0 0 24 24" 
         stroke-width="1.5" 
         stroke="currentColor" 
         class="h-10 ml-1 duration-200 ease-in-out"
         data-nav-target="arrow">
      <path stroke-linecap="round" 
            stroke-linejoin="round" 
            d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
    </svg>
  </div>

  <div class="max-w-screen-xl flex flex-row-reverse flex-wrap items-center justify-between mx-auto p-2">

    <%= link_to root_path, class: 'flex items-center space-x-3 mr-1 rtl:space-x-reverse' do %>
      <span class="self-center text-fit-h sm:text-3xl whitespace-nowrap text-gray-600 font-['Racing_Sans_One']">
        Mikey Clarke
      </span>
      <%= image_tag 'kissy-transparent.png', class: 'h-9 w-auto' %>
    <% end %>

    <button data-action="click->nav#toggleMobile" type="button" class="inline-flex items-center p-2 ml-1 w-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-300">
      <span class="sr-only">Open main menu</span>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
      </svg>
    </button>

    <!-- Mobile -->
    <div class="w-full hidden md:hidden ml-6 text-sm text-gray-600 font-medium nav" data-nav-target="mobile">
      <ul>
        <% @nav_items.each do |nav_item| %>
          <li class="my-3">
            <%= link_to nav_item.label, nav_item.path, class: "font-['Racing_Sans_One'] text-xl" %>
            <% if nav_item.children.present? %>
              <ul class="ml-4">
                <% nav_item.children.each do |nav_sprog| %>
                  <li class="">
                    <%= link_to nav_sprog.label, nav_sprog.path %>
                    <% if nav_sprog.children.present? %>
                      <ul class="ml-4">
                        <% nav_sprog.children.each do |nav_grandsprog| %>
                          <li class="italic">
                            <%= link_to nav_grandsprog.label, nav_grandsprog.path %>
                          </li>
                        <% end %>
                      </ul>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Desktop -->
    <div class="hidden md:block w-auto ml-6 text-gray-600 nav">
      <ul class="flex flex-row font-medium p-0 mt-0 rounded-lg space-x-8">

        <% @nav_items.each do |nav_item| %>

          <li class="p-1 rounded-lg" 
              data-nav-target="<%= nav_item.key%>Menu" 
              data-action="mouseover->nav#open<%= nav_item.key.capitalize %>Submenu mouseout->nav#close<%= nav_item.key.capitalize %>Submenu">

            <%= link_to nav_item.label, nav_item.path, class: "text-xl font-['Racing_Sans_One']" %>            

            <% if nav_item.children.present? %>
              <div data-nav-target="<%= nav_item.key %>Submenu" class="z-10 hidden bg-white rounded-lg shadow absolute">
                <ul class="text-sm text-gray-700 py-2">
                  <% nav_item.children.each do |nav_child| %>
                    <li class="block px-4 py-1">

                      <%= link_to nav_child.label, nav_child.path %>
                      
                      <% if nav_child.children.present? %>
                        <ul>
                        <% nav_child.children.each do |nav_grandkid| %>
                          <li>
                            <%= link_to nav_grandkid.label, nav_grandkid.path, class: 'block px-4 pt-1 italic' %>
                          </li>
                        <% end %>
                        </ul>
                      <% end %>
                    </li> 
                  <% end %>
                </ul>
              </div>

            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
