<div data-controller="prev-nek"
     data-prev-nek-duration-value="<%= PostComponent::DURATION %>"
     data-prev-nek-prev-is-nsfw-value="<%= prev&.nsfw? == true %>"
     data-prev-nek-nek-is-nsfw-value="<%= nek&.nsfw? == true %>"
     class="m-3"
     >

  <div class="flex flex-col sm:flex-row items-center gap-0">
    <%= link_to prev_path, 
        class: prev_css_classes,
        data: { 'prev-nek-target': 'prev' } do %>

      <div class="grow flex flex-col justify-between p-2">
        <h5 class="tracking-tight leading-[1.1rem] sm:leading-[1.1rem] text-gray-600 dark:text-white sm:max-h-9 overflow-hidden text-ellipsis text-md sm:text-lg font-['Racing_Sans_One'] <%= prev.present? ? 'max-h-6 ' : 'max-h-9 my-auto' %>">
          <% if prev.present? %>
            <%= prev.title.truncate 50, separator: ' ', omission: ' ...' %>
          <% else %>
            No earlier posts! Oodles of others though.
          <% end %>
        </h5>

        <% if prev.present? %>
          <div>
            <span class="text-gray-600 float-left">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 inline-block">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
              </svg>
              Earlier
            </span> 
            <span class="text-gray-600 text-sm">
              <%= prev.published_at.strftime "%-d %b %Y" %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="flex-none object-cover w-[4.5rem] sm:w-24 md:w-32 h-[4.5rem] sm:h-24 rounded-tr-lg sm:rounded-tr-none">
        <% if prev.present? %>
          <%= image_tag prev.resized_blob_or_orig_or_placeholder_url(x: 96, y: 72),
              class: 'w-full h-full rounded-tr-lg sm:rounded-tr-none' %>
        <% else %>
          <%= image_tag 'kissy-transparent.png', class: 'h-full mx-auto p-3' %>
        <% end %>
      </div>
    <% end %>

    <%= link_to comfy_blog_posts_path(category: @category&.label),
                class: css_classes_for_category do %>
      <%= @category&.label || 'All Posts' %>
    <% end %>

    <%= link_to nek_path,
        class: nek_css_classes,
        data: { 'prev-nek-target': 'nek' } do %>

      <div class="flex-none object-cover w-[4.5rem] sm:w-24 md:w-32 h-[4.5rem] sm:h-24 rounded-tr-lg sm:rounded-tr-none">
        <% if nek.present? %>
          <%= image_tag nek.resized_blob_or_orig_or_placeholder_url(x: 96, y: 72),
              class: 'w-full h-full rounded-bl-lg sm:rounded-bl-none' %>
        <% else %>
          <%= image_tag 'kissy-transparent.png', class: 'h-full mx-auto p-3' %>
        <% end %>
      </div>

      <div class="grow flex flex-col justify-between p-2">
        <h5 class="tracking-tight leading-[1.1rem] sm:leading-[1.1rem] text-gray-600 dark:text-white  sm:max-h-9 overflow-hidden text-ellipsis text-md sm:text-lg font-['Racing_Sans_One'] <%= nek.present? ? 'max-h-6' : 'max-h-9 my-auto' %>">
          <% if nek.present? %>
            <%= nek.title.truncate 50, separator: ' ', omission: ' ...' %>
          <% else %>
            No later posts! Oodles of others though.
          <% end %>
        </h5>
        
        <% if nek.present? %>
          <div>
            <span class="text-gray-600 text-sm">
              <%= nek.published_at.strftime "%-d %b %Y" %>
            </span>
            
            <span class="text-gray-600 float-right">
              Later
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 inline-block">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
              </svg>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
