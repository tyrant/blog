<div data-controller="post" 
     data-post-nsfw-value="<%= @post.nsfw? %>"
     data-post-duration-value="<%= PostComponent::DURATION %>"
     class="<%= css_classes %>">

  <div class="relative">
    <%= link_to post_link do %>
      <div class="<%= css_classes_for_datebg %>" 
           data-post-target="datebg">
        <div class="h-14 bg-gradient-to-t from-transparent to-70% to-neutral-700/70 rounded-t-xl">
        </div>
      </div>

      <div class="absolute w-full top-0 left-0 z-10 p-3 text-sm text-white text-outlined font-bold"
           data-post-target="date">
        <%= @post.published_at.strftime "%-d %b %Y" %>
      </div>
    <% end %>

    <div class="absolute top-3 right-3 z-10" 
         data-post-target="categories">
      <% @post.categories.public_names.nsfw_first.each do |category| %>
        <%= link_to comfy_blog_posts_path(category: category.label) do %>
          <span class="<%= css_classes_for_category(category) %>">
            <%= category.label %>
          </span>
        <% end %>
      <% end %>
    </div>

    <%= link_to post_link,
        class: css_classes_for_body,
        data: { 'post-target': 'body' } do %>

      <div class="duration-150" 
           data-post-target="scale">
        <%= image_tag post_image_path,
            class: css_classes_for_image %>

        <div class="<%= css_classes_for_titlebg %>">
          <h5 class="absolute w-full p-5 bottom-0 left-0
                     font-['Racing_Sans_One']
                     text-center text-gray-100 text-outlined
                     <%= css_classes_for_title %>">
            <%= post_title %>
          </h5>
        </div>
      </div>

      <% if @show_text %>
        <div class="px-4 mt-2 mb-2">
          <div class="text-sm text-gray-600 dark:text-gray-300">
            <%= post_content %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
