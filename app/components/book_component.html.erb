<div class="p-6 bg-white rounded-lg shadow-lg" data-controller="book">
  <%= link_to @link_path do %>
    <%= image_tag @image_path, class: 'shadow-xl w-full duration-150 ease-in hover:scale-[1.01]' %>

    <div class="px-2 mt-2 mb-4">
      <div class="text-sm text-gray-600">
        
        <span class="inline-block uppercase text-sm text-gray-400 py-3 leading-[0.9rem]">
          The Sex Commandos Thwart The Third Vaginal Apocalypse
        </span>

        <br>
        
        <span class="inline-block pb-1 font-['Great_Vibes'] text-xl">
          ~~ Part&nbsp;&nbsp;<%= @number %>/6 ~~
        </span>
        
        <br>

        <span class="inline-block pb-3 font-['Racing_Sans_One'] text-3xl uppercase leading-[1.5rem]">
          <%= @title %>
        </span>
        
        <br>

        <span class="inline-block py-1 text-xs text-gray-400">
          <%= @blurb %>
        </span>
      </div>
    </div>
  <% end %>
</div>
