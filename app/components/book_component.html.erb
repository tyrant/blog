<div class="p-[5%] h-full
            bg-white dark:bg-gray-800 rounded-lg shadow-lg text-center"
     data-controller="book">
  <%= link_to @link_path do %>
    <%= image_tag @image_path, class: 'shadow-xl w-full duration-100 ease-in hover:scale-[1.015]' %>

    <div class="mt-2">
      <div class="text-sm text-gray-600 dark:text-gray-300">
        
        <span class="inline-block uppercase
                     text-xs md:text-sm text-gray-400 dark:text-gray-500 leading-[0.7rem] md:leading-[0.8rem]
                     py-2 md:py-3">
          The Sex Commandos Thwart The Third Vaginal Apocalypse
        </span>

        <br>
        
        <span class="inline-block pb-1
                     font-['Great_Vibes'] text-lg md:text-lg lg:text-xl">
          ~~ Part&nbsp;&nbsp;<%= @number %>/6 ~~
        </span>
        
        <br>

        <span class="inline-block pb-3
                     font-['Racing_Sans_One'] text-xl md:text-2xl lg:text-3xl uppercase leading-[0.9rem] md:leading-[1.1rem] lg:leading-[1.35rem]">
          <%= @title %>
        </span>
        
        <br>

        <span class="inline-block pt-1
                     text-xs text-gray-400 dark:text-gray-500 leading-[0.8rem]">
          <%= @blurb %>
        </span>
      </div>
    </div>
  <% end %>
</div>
