          <cite class="pe-3 font-medium text-gray-900 leading-tight">
            Sarah Jane Barnett
          </cite>
          <img class="w-10 h-10 rounded-full inline" src="https://images.squarespace-cdn.com/content/v1/5c399f8455b02c1720726bc3/a16178bc-005d-48f8-9379-29d3c056c8d1/SJB+author+photo_colour.jpg" alt="profile picture">
          <cite class="ps-3 text-sm text-gray-500">
            <%= link_to 'https://sarahjanebarnett.net/', 'https://sarahjanebarnett.net/' %>
