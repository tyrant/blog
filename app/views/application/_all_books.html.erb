<% book_previews.each_with_index do |book_preview, i| %>
  <% 
    classes = %w(basis-1/2 sm:basis-1/3 lg:basis-1/4)
    if footer
      classes << if i < 3
          'hidden sm:block'
        elsif i < 4
          'hidden lg:block'
        elsif i < 5
          'hidden xl:block'
        else
          'hidden'
        end
    end
  %>

  <div class="<%= classes.join(' ') %>">
    <%= book_preview %>
  </div>
<% end %>
