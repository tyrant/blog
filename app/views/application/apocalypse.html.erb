<% content_for :banner do %>
  <div class="title-bg"
       style="background-image: url(<%= image_path @random_cover_image %>);
              background-position-y: <%= rand(40..60) %>%;">
    <div class="transparency">
      <h1 class="text-center text-3xl sm:text-4xl uppercase font-['Racing_Sans_One'] leading-[1.4rem] sm:leading-[1.7rem] mb-2 sm:mb-3">
        The Sex Commandos<br> Thwart The Third<br> Vaginal Apocalypse
      </h1>

      <h2 class="text-center text-2xl sm:text-3xl font-['Great_Vibes'] leading-[1.2rem] sm:leading-[1.5rem]">
        A hilarious and romantic romp<br> through irresistibly sexy military history
      </h2>
    </div>
  </div>
<% end %>

<div class="mx-10 sm:mx-6 lg:mx-24 xl:mx-6 my-6 grid gap-6 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
  <%= render 'all_books', only_paid: false %>
</div>
