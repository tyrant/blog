<div class="purchase">
  <h1>Grab your copy at</h1>

  <div class="purchase-links">
    <% @amazon_tlds.each do |tld| %>
      <%= link_to "https://www.amazon#{tld}/dp/#{@amazon}/", class: 'amazon-mk' do %>
        <%= image_tag 'amazon-a.png' %>
        <span><%= tld %></span>
      <% end %>
    <% end %>
  </div>  
  <div class="purchase-links non-amazons">
    <% @non_amazons.each do |book| %>
      <%= link_to book[:url], class: 'non-amazon' do %>
        <div class="v-align">
          <%= image_tag asset_path(book[:img]) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
