- content_for :right_column do
  %h6.text-muted Totals
  %ul.list-unstyled.small
    %li
      %strong= number_with_delimiter @blizzard_stats[:posts]
      posts
    %li
      %strong= number_with_delimiter @blizzard_stats[:entries]
      blizzard entries
    %li
      %strong= number_with_delimiter @blizzard_stats[:notes]
      notes

.page-header
  %h2 Substack Blizzard — text groups due for a repost

.mb-3.flex.flex-row
  = button_to "Backfill all posts’ notes", comfy_admin_substack_blizzard_backfill_all_path, method: :post, class: "btn btn-outline-secondary btn-sm", form: { data: { turbo_confirm: "Backfill every Substack post’s notes now? This runs in the background." } }, data: { confirm: "Backfill every Substack post’s notes now? This runs in the background." }
  = button_to "Refresh Note/Post likes", comfy_admin_substack_blizzard_refresh_likes_path, method: :post, class: "btn btn-outline-secondary btn-sm", form: { data: { turbo_confirm: "Re-fetch every note’s and post’s like count now? This runs in the background." } }, data: { confirm: "Re-fetch every note’s and post’s like count now? This runs in the background." }

%section.mb-4
  %h5 Automated reposting
  %span.text-muted.small
    One note is reposted every interval, picked at random weighted by each entry’s summed Note likes plus parent Post likes: heavily-liked entries repost more often.
  = form_with url: comfy_admin_substack_blizzard_settings_path, method: :post, class: "form-inline mt-2" do
    %label.mr-2{ for: "interval_minutes" } Repost every (minutes):
    = number_field_tag :interval_minutes, @config.interval_minutes, min: 1, max: 1440, class: "form-control mr-3", style: "width: 6rem;"
    %label.mr-2{ for: "cooldown_hours" } Per-entry cooldown (hours):
    = number_field_tag :cooldown_hours, @config.cooldown_hours, min: 0, max: 8760, class: "form-control mr-2", style: "width: 6rem;"
    = submit_tag "Save settings", class: "btn btn-primary btn-sm"
  %p.text-muted.small.mt-2
    - if @config.last_reposted_at
      Last repost: #{l(@config.last_reposted_at, format: :long)}
    - else
      No reposts yet.

  - if @odds.any?
    %h6.text-muted.mt-3 Most likely to repost next
    %table.table.table-sm.small.mb-0
      %thead
        %tr
          %th Post
          %th.text-right Likes
          %th.text-right Chance
      %tbody
        - @odds.each do |candidate|
          %tr
            %td
              = candidate.title
              - if candidate.text.present?
                %span.text-muted= " — #{truncate(candidate.text, length: 70)}"
            %td.text-right= number_with_delimiter(candidate.likes)
            %td.text-right= number_to_percentage(candidate.probability * 100, precision: 2)

= form_with url: comfy_admin_substack_blizzard_path, method: :get do
  .form-inline.mb-3
    %label.mr-2{ for: "days" } Most recent note older than (days):
    = number_field_tag :days, @days, min: 0, max: 60, class: "form-control mr-2", style: "width: 6rem;"
    = text_field_tag :q, params[:q], placeholder: "search post titles", class: "form-control mr-2"
    = submit_tag "Filter", class: "btn btn-secondary"

- if @due.empty?
  %p.text-muted No text groups have a most-recent note older than #{@days} days.
- else
  = comfy_paginate @due
  - @due.group_by(&:categorization).each do |categorization, dues|
    - post = categorization.categorized
    %section.mb-4
      %h5
        = link_to post.title, comfy_blog_post_path(year: post.year, month: post.month, slug: post.slug)
        = link_to "(admin)", edit_comfy_admin_blog_post_path(site_id: post.site_id, id: post.id), class: "small"
      %ul.list-unstyled
        - dues.each do |due|
          %li.card.mb-2
            .card-body
              - notes = Array(due.entry['notes'])
              %p.text-muted.small
                Last posted #{due.latest ? l(due.latest, format: :long) : 'never'}
                · #{notes.size} note(s) in this group
                - if notes.any?
                  ·
                  = blizzard_note_links(notes)
              .blizzard-copy.d-flex.align-items-start
                .border.p-2.flex-grow-1.blizzard-text{ style: "white-space: pre-wrap;" }= due.entry["text"]
                %button.btn.btn-sm.btn-outline-secondary.ml-2.copy-blizzard-text{ type: "button" } Copy
              %p.text-muted.small.mb-1 Post this text as a new Note on Substack, then record it:
              = form_with url: comfy_admin_substack_blizzard_add_note_path, method: :post, class: "form-inline" do
                = hidden_field_tag :categorization_id, due.categorization.id
                = hidden_field_tag :uid, due.uid
                = hidden_field_tag :days, @days
                = hidden_field_tag :page, params[:page]
                = hidden_field_tag :q, params[:q]
                = text_field_tag :url, nil, placeholder: "new note URL", class: "form-control form-control-sm mr-1"
                = text_field_tag :timestamp, nil, placeholder: "timestamp e.g. 21 Jun at 19:00", class: "form-control form-control-sm mr-1"
                = submit_tag "Add manually", class: "btn btn-outline-secondary btn-sm"
              %p.text-muted.small.mb-1.mt-2 Or replace this group's stored text with the rich content of a real note:
              = form_with url: comfy_admin_substack_blizzard_reseed_path, method: :post, class: "form-inline" do
                = hidden_field_tag :categorization_id, due.categorization.id
                = hidden_field_tag :uid, due.uid
                = hidden_field_tag :days, @days
                = hidden_field_tag :page, params[:page]
                = hidden_field_tag :q, params[:q]
                = text_field_tag :note_url, nil, placeholder: "rich note URL to re-seed body_json", class: "form-control form-control-sm mr-1", style: "width: 24rem;"
                = submit_tag "Re-seed rich text", class: "btn btn-outline-info btn-sm"
  = comfy_paginate @due
