.page-header
  %h2 Substack Blizzard — text groups due for a repost

%section.mb-4{ data: { controller: "blizzard-forecast", "blizzard-forecast-groups-value": @forecast.to_json, "blizzard-forecast-saved-value": @saved_schedule.to_json, "blizzard-forecast-save-url-value": comfy_admin_substack_blizzard_schedule_path } }
  %h5 Repost forecast
  .form-inline.mb-2
    %label.mr-2{ for: "forecast-days" } Repost every (days):
    %input#forecast-days.form-control.mr-2{ type: "number", min: 1, max: 365, value: 7, style: "width: 6rem;", data: { "blizzard-forecast-target": "days", action: "input->blizzard-forecast#recompute" } }
    .form-check.form-check-inline.mr-3
      %input#forecast-even.form-check-input{ type: "checkbox", checked: true, data: { "blizzard-forecast-target": "even", action: "change->blizzard-forecast#recompute" } }
      %label.form-check-label{ for: "forecast-even" } Evenly spread reposts across the interval
    .form-check.form-check-inline.mr-3
      %input#forecast-shuffle.form-check-input{ type: "checkbox", data: { "blizzard-forecast-target": "shuffle", action: "change->blizzard-forecast#recompute" } }
      %label.form-check-label{ for: "forecast-shuffle" } Shuffle each day’s reposts
  .form-inline.mb-2
    %button.btn.btn-primary.btn-sm.mr-2{ type: "button", data: { action: "click->blizzard-forecast#save" } } Save Forecasts
    %span.small{ data: { "blizzard-forecast-target": "status" } }
    %span.text-muted.small.ml-3 Forecasts each group’s next reposts over the coming 90 days.
  :css
    #blizzard-forecast-calendar .fc-daygrid-day-events { max-height: 100px; overflow-y: auto; }
  #blizzard-forecast-calendar{ data: { "blizzard-forecast-target": "calendar" } }

= form_with url: comfy_admin_substack_blizzard_path, method: :get do
  .form-inline.mb-3
    %label.mr-2{ for: "days" } Most recent note older than (days):
    = number_field_tag :days, @days, min: 0, max: 60, class: "form-control mr-2", style: "width: 6rem;"
    = text_field_tag :q, params[:q], placeholder: "search post titles", class: "form-control mr-2"
    = submit_tag "Filter", class: "btn btn-secondary"

- if @due.empty?
  %p.text-muted No text groups have a most-recent note older than #{@days} days.
- else
  = comfy_paginate @due
  - @due.group_by(&:categorization).each do |categorization, dues|
    - post = categorization.categorized
    %section.mb-4
      %h5
        = link_to post.title, comfy_blog_post_path(year: post.year, month: post.month, slug: post.slug)
        = link_to "(admin)", edit_comfy_admin_blog_post_path(site_id: post.site_id, id: post.id), class: "small"
      %ul.list-unstyled
        - dues.each do |due|
          %li.card.mb-2
            .card-body
              - notes = Array(due.entry['notes'])
              %p.text-muted.small
                Last posted #{due.latest ? l(due.latest, format: :long) : 'never'}
                · #{notes.size} note(s) in this group
                - if notes.any?
                  ·
                  = blizzard_note_links(notes)
              .blizzard-copy.d-flex.align-items-start
                .border.p-2.flex-grow-1.blizzard-text{ style: "white-space: pre-wrap;" }= due.entry["text"]
                %button.btn.btn-sm.btn-outline-secondary.ml-2.copy-blizzard-text{ type: "button" } Copy
              %p.text-muted.small.mb-1 Post this text as a new Note on Substack, then record it:
              = form_with url: comfy_admin_substack_blizzard_add_note_path, method: :post, class: "form-inline" do
                = hidden_field_tag :categorization_id, due.categorization.id
                = hidden_field_tag :index, due.index
                = hidden_field_tag :days, @days
                = hidden_field_tag :page, params[:page]
                = hidden_field_tag :q, params[:q]
                = text_field_tag :url, nil, placeholder: "new note URL", class: "form-control form-control-sm mr-1"
                = text_field_tag :timestamp, nil, placeholder: "timestamp e.g. 21 Jun at 19:00", class: "form-control form-control-sm mr-1"
                = submit_tag "Add manually", class: "btn btn-outline-secondary btn-sm"
              %p.text-muted.small.mb-1.mt-2 Or replace this group's stored text with the rich content of a real note:
              = form_with url: comfy_admin_substack_blizzard_reseed_path, method: :post, class: "form-inline" do
                = hidden_field_tag :categorization_id, due.categorization.id
                = hidden_field_tag :index, due.index
                = hidden_field_tag :days, @days
                = hidden_field_tag :page, params[:page]
                = hidden_field_tag :q, params[:q]
                = text_field_tag :note_url, nil, placeholder: "rich note URL to re-seed body_json", class: "form-control form-control-sm mr-1", style: "width: 24rem;"
                = submit_tag "Re-seed rich text", class: "btn btn-outline-info btn-sm"
  = comfy_paginate @due
