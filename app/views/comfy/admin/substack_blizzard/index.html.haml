- content_for :right_column do
  %h6.text-muted Totals
  %ul.list-unstyled.small
    %li
      %strong= number_with_delimiter @blizzard_stats[:posts]
      posts
    %li
      %strong= number_with_delimiter @blizzard_stats[:entries]
      blizzard entries
    %li
      %strong= number_with_delimiter @blizzard_stats[:notes]
      notes
  - if @stat_series[:labels].any?
    %button.btn.btn-outline-secondary.btn-sm.mt-1{ type: "button", data: { toggle: "modal", target: "#blizzard-graph-modal" } } Graph

.page-header
  %h2 Substack Blizzard — text groups due for a repost

.mb-3.d-flex{ style: 'gap: .5rem' }
  = button_to "Backfill all Posts' Notes", comfy_admin_substack_blizzard_backfill_all_path, method: :post, class: "btn btn-outline-secondary btn-sm", form: { data: { turbo_confirm: "Backfill every Substack post’s notes now? This runs in the background." } }, data: { confirm: "Backfill every Substack post’s notes now? This runs in the background." }
  = button_to "Backfill unattached Notes", comfy_admin_substack_blizzard_backfill_unattached_path, method: :post, class: "btn btn-outline-secondary btn-sm", form: { data: { turbo_confirm: "Backfill the unattached-notes pool now? This runs in the background." } }, data: { confirm: "Backfill the unattached-notes pool now? This runs in the background." }
  = button_to "Refresh all Note/Post likes", comfy_admin_substack_blizzard_refresh_likes_path, method: :post, class: "btn btn-outline-secondary btn-sm", form: { data: { turbo_confirm: "Re-fetch every note’s and post’s like count now? This runs in the background." } }, data: { confirm: "Re-fetch every note’s and post’s like count now? This runs in the background." }

#job-progress.mb-3{ data: { url: comfy_admin_substack_blizzard_job_progress_path }, style: "display: none" }
  %h6.text-muted.mb-1 Background jobs
  #job-progress-rows

:javascript
  (function () {
    var panel = document.getElementById("job-progress");
    if (!panel) return;
    var rowsEl = document.getElementById("job-progress-rows");
    var url = panel.dataset.url;
    var badge = { running: "badge-info", finished: "badge-success", failed: "badge-danger" };
    function ago(iso) {
      var s = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
      return s < 60 ? s + "s ago" : Math.round(s / 60) + "m ago";
    }
    function render(rows) {
      panel.style.display = rows.length ? "block" : "none";
      rowsEl.innerHTML = rows.map(function (r) {
        return '<div class="mb-1 small">' +
          '<span>' + r.label + '</span> ' +
          '<span class="badge ' + (badge[r.status] || "badge-secondary") + '">' + r.status + '</span> ' +
          '<span class="text-muted">' + r.completed + ' / ' + r.total + ' (' + r.percent + '%) · updated ' + ago(r.updated_at) + '</span>' +
          '<div class="progress" style="height: 4px;"><div class="progress-bar" style="width: ' + r.percent + '%"></div></div>' +
          '</div>';
      }).join("");
    }
    function anyRunning(rows) {
      return rows.some(function (r) { return r.status === "running"; });
    }
    function poll() {
      fetch(url, { headers: { Accept: "application/json" } })
        .then(function (x) { return x.json(); })
        .then(function (rows) {
          render(rows);
          // Only keep polling while a job is actually running; stop once idle.
          if (anyRunning(rows)) window.setTimeout(poll, 3000);
        })
        .catch(function () {});
    }
    poll();
  })();

%section.mb-4
  %h5 Repost selection
  %span.text-muted.small
    Posting a Note is always a manual, hands-on step — Substack blocks automated Note-creation outright, so this just picks what to suggest copying next. 74% of the time it’s a per-post text group, picked at random weighted by each entry’s summed Note likes plus parent Post likes (heavily-liked entries surface more often). 24% is a random featured quotation from the
    = succeed "," do
      = link_to "Quotations pool", comfy_admin_quotations_path
    rendered as ready-to-copy rich text (bold post-title link → the quote linking its original comment → the author), mirroring the post-footer quotation template. The remaining 2% is a weighted pick from the unattached-notes pool below. Every suggestion — text group, quotation, or unattached note — comes with a Copy button carrying full rich formatting, and an Add-manually form to record the Note URL once you’ve posted it. The odds table below reflects only the 74% per-post text share.
  = form_with url: comfy_admin_substack_blizzard_settings_path, method: :post, class: "form-inline mt-2" do
    %label.mr-2{ for: "cooldown_hours" } Per-post cooldown (hours):
    = number_field_tag :cooldown_hours, @config.cooldown_hours, min: 0, max: 8760, class: "form-control mr-2", style: "width: 6rem;"
    = submit_tag "Save settings", class: "btn btn-primary btn-sm"
  %p.text-muted.small.mt-2
    - if @config.last_reposted_at
      Last repost: #{l(@config.last_reposted_at, format: :long)}
    - else
      No reposts yet.

  - if @odds.any?
    %h6.text-muted.mt-3 Most likely to be suggested next
    %table.table.table-sm.small.mb-0
      %thead
        %tr
          %th Post
          %th.text-right Likes
          %th.text-right Chance
      %tbody
        - @odds.each do |candidate|
          %tr
            %td{ style: "max-width: 26rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis" }
              = candidate.title
              - if candidate.text.present?
                %span.text-muted= " — #{truncate(candidate.text, length: 70)}"
            %td.text-right= number_with_delimiter(candidate.likes)
            %td.text-right= number_to_percentage(candidate.probability * 100, precision: 2)

  %h6.text-muted.mt-3 Next repost suggestion
  - if @next_repost.nil?
    %p.text-muted.small.mb-0 Nothing eligible to suggest right now.
  - else
    %p.text-muted.small.mb-1
      - if @next_repost["categorization_id"].present?
        - next_post = Comfy::Cms::Categorization.find_by(id: @next_repost["categorization_id"])&.categorized
        = "Text group for: #{next_post&.title}"
      - elsif @next_repost["uid"].present?
        Unattached note
      - else
        Quotation
    = render "copy_and_record_form", entry: @next_repost, categorization_id: @next_repost["categorization_id"],
      uid: @next_repost["uid"], quotation_id: @next_repost["quotation_id"], days: @days, page: params[:page], q: params[:q]

%section.mb-4
  %h5 Unattached Notes
  %p.text-muted.small
    A third repost pool: Notes with no parent Post or Quotation — text that stands on its own. Paste Note URLs into the
    %code notes
    key below, save, then Backfill to turn them into tracked entries — URL, likes and posting history catalogued per entry, same as the per-post pool.
  .json-fields
    = form_with url: comfy_admin_substack_blizzard_notes_json_path, method: :post do
      %textarea.form-control{ name: "data_json_text", style: "font-family: monospace; min-height: 12rem;", data: { 'cms-cm-mode': 'application/json' } }= @config.data_json_text
      = submit_tag "Save unattached notes", class: "btn btn-primary btn-sm mt-2"

- if @stat_series[:labels].any?
  #blizzard-graph-modal.modal.fade{ tabindex: "-1", role: "dialog", "aria-hidden": "true" }
    .modal-dialog.modal-lg{ role: "document" }
      .modal-content
        .modal-header
          %h5.modal-title Totals over time
          %button.close{ type: "button", data: { dismiss: "modal" }, "aria-label": "Close" }
            %span{ "aria-hidden": "true" } &times;
        .modal-body
          %div{ style: "position: relative; height: 60vh;" }
            %canvas#blizzard-stats-chart{ data: { series: @stat_series.to_json } }

= form_with url: comfy_admin_substack_blizzard_path, method: :get do
  .form-inline.mb-3
    %label.mr-2{ for: "days" } Most recent note older than (days):
    = number_field_tag :days, @days, min: 0, max: 60, class: "form-control mr-2", style: "width: 6rem;"
    = text_field_tag :q, params[:q], placeholder: "search post titles", class: "form-control mr-2"
    = submit_tag "Filter", class: "btn btn-secondary"

- if @due.empty?
  %p.text-muted No text groups have a most-recent note older than #{@days} days.
- else
  = comfy_paginate @due
  - @due.group_by(&:categorization).each do |categorization, dues|
    - post = categorization.categorized
    %section.mb-4
      %h5
        = link_to post.title, comfy_blog_post_path(year: post.year, month: post.month, slug: post.slug)
        = link_to "(admin)", edit_comfy_admin_blog_post_path(site_id: post.site_id, id: post.id), class: "small"
      %ul.list-unstyled
        - dues.each do |due|
          %li.card.mb-2
            .card-body
              - notes = Array(due.entry['notes'])
              %p.text-muted.small
                Last posted #{due.latest ? l(due.latest, format: :long) : 'never'}
                · #{notes.size} note(s) in this group
                - if notes.any?
                  ·
                  = blizzard_note_links(notes)
              = render "copy_and_record_form", entry: due.entry, categorization_id: due.categorization.id,
                uid: due.uid, quotation_id: nil, days: @days, page: params[:page], q: params[:q]
              %p.text-muted.small.mb-1.mt-2 Or replace this group's stored text with the rich content of a real note:
              = form_with url: comfy_admin_substack_blizzard_reseed_path, method: :post, class: "form-inline" do
                = hidden_field_tag :categorization_id, due.categorization.id
                = hidden_field_tag :uid, due.uid
                = hidden_field_tag :days, @days
                = hidden_field_tag :page, params[:page]
                = hidden_field_tag :q, params[:q]
                = text_field_tag :note_url, nil, placeholder: "rich note URL to re-seed body_json", class: "form-control form-control-sm mr-1", style: "width: 24rem;"
                = submit_tag "Re-seed rich text", class: "btn btn-outline-info btn-sm"
  = comfy_paginate @due
