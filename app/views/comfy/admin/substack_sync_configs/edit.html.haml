.page-header
  %h2 Substack Sync Settings

.mb-3
  - if @config.session_checked_at.nil?
    .alert.alert-secondary.mb-2 Session cookie not yet checked.
  - elsif @config.session_healthy?
    .alert.alert-success.mb-2 Session cookie OK — last verified #{time_ago_in_words(@config.session_checked_at)} ago.
  - else
    .alert.alert-danger.mb-2
      %strong Session cookie rejected — refresh it.
      - if @config.session_error.present?
        %div.small= @config.session_error
      %div.small Detected #{time_ago_in_words(@config.session_checked_at)} ago. All Substack sync halts until the cookie is refreshed.
  = form_with url: check_connection_comfy_admin_substack_sync_config_path, method: :post do
    = submit_tag "Check connection now", class: "btn btn-outline-secondary btn-sm"

= comfy_form_with model: @config, scope: :substack_sync_config, url: comfy_admin_substack_sync_config_path, method: :patch do |form|

  = form.text_area :subtitle,
                   label: "Subtitle template — used for every post",
                   style: "field-sizing: content;"

  .json-fields
    = form.text_area :subtitle_variables_json,
                     label: "Subtitle template variables — JSON: { \"var\": [\"choice\", …] }; each {{ var }} renders a random choice",
                     style: "font-family: monospace; min-height: 10rem;",
                     data: { 'cms-cm-mode': 'application/json' }

  .form-group.mb-3
    %label.form-text.text-muted Preview
    .d-flex.align-items-center
      %button.btn.btn-outline-secondary.btn-sm.mr-2{type: "button", data: { subtitle_sample: true, template_field: "substack_sync_config_subtitle", variables_field: "substack_sync_config_subtitle_variables_json", output: "subtitle_sample_output" }}
        Generate sample
      %textarea.form-control.form-control-sm{readonly: true, id: "subtitle_sample_output", placeholder: "Sample output…"}

  = form.text_area :footer_json_text,
                   label: "Footer blocks (ProseMirror JSON — subscribe CTA through the Subscribe button)",
                   style: "font-family: monospace; min-height: 22rem;",
                   data: { 'cms-cm-mode': 'application/json', 'cms-cm-fold-root': true }

  = form.check_box :quotation_rotation_enabled,
                   label: "Rotate featured quotes across every Substack post (leave off while testing)"

  = form.text_field :quotation_rotation_days,
                    label: "Rotate featured quotes every … days"

  = form.text_field :reviews_draft_id,
                    label: "Reviews page 1 — Substack draft id (e.g. 207698961). Pages 2+ are auto-created in groups of 20."

  = form.form_actions do
    = submit_tag "Save", class: "btn btn-primary ml-sm-1"

%hr
%h5 Re-sync all posts
%p.text-muted.small
  Runs a full Substack sync of every linked post on the worker (rebuilds body,
  images, footer template, tags, subtitle). Already-published posts are re-published
  in place — no subscriber email is sent.
= form_with url: sync_all_comfy_admin_substack_sync_config_path, method: :post do
  = submit_tag "Re-sync all posts now", class: "btn btn-outline-secondary"

%hr
%h5 Re-capture template from a reference draft
%p.text-muted.small
  Rebuild the whole below-body template (everything from the "Original:" link
  down) from a Substack draft, turning the dynamic bits into directives — the
  Original link, the quotation run, and the "Bullshit Emeritus" conditional.
  Overwrites the advice subtitle + template above. Use the draft's edit-URL id,
  e.g. 206980888.
= form_with url: recapture_comfy_admin_substack_sync_config_path, method: :post, class: "form-inline" do
  = text_field_tag :reference_draft_id, nil, placeholder: "draft id", class: "form-control mr-2"
  = submit_tag "Re-capture", class: "btn btn-outline-secondary"
