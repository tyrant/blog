- unless @post.new_record?
  .form-group.mt-3
    - banner_url = asset_path('orig-bad-advice-banner.jpg')
    %button.btn.btn-outline-secondary{type: "button", id: "copy-for-medium", data: {post_id: @post.id, banner_url: banner_url}}
      Copy for Medium
    %button.btn.btn-outline-primary.ml-2{type: "button", id: "sync-to-substack", data: {sync_url: sync_to_substack_comfy_admin_blog_post_path(@site, @post)}}
      Sync to Substack
    %span.medium-copy-status.ml-2{style: "display: none;"}
    %span.substack-sync-status.ml-2{style: "display: none;"}
