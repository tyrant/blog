= comfy_admin_partial "comfy/admin/blog/partials/post_form_before", form: form

= form.text_area :title, data: { slugify: true }, style: 'field-sizing: content;'
= form.text_area :slug, readonly: true, data: { slug: true }, style: 'field-sizing: content;'

- if (options = ::Comfy::Cms::Layout.options_for_select(@site)).present?
  = form.select :layout_id, options, {}, {data: {url: form_fragments_comfy_admin_blog_post_path(@site, @post.id.to_i)}, id: "fragments-toggle"}

#form-fragments-container
  = render "comfy/admin/cms/fragments/form_fragments", record: @post, scope: :post

= form.text_area :scratchpad, style: 'field-sizing: content;'

= render "comfy/admin/cms/categories/form", form: form

.form-group.row
  %label.col-sm-2.col-form-label.pt-0 Substack audience
  .col-sm-10
    = form.select :substack_audience, Comfy::Blog::Post::SUBSTACK_AUDIENCES.invert.to_a, {}, class: "form-control", style: "max-width: 20rem;"
    %small.form-text.text-muted Who the mirrored Substack post is for. Applied on the next sync.

- if (all_tags = Tag.alphabetical).present?
  .form-group.row.tags-widget
    %label.col-sm-2.col-form-label.pt-0 Tags
    .col-sm-10
      = hidden_field_tag "post[tag_ids][]", ""
      = select_tag "post[tag_ids][]", options_for_select(all_tags.map { |tag| [tag.name, tag.id] }, @post.tag_ids), multiple: true, class: "form-control js-tags-select"
      %small.form-text.text-muted Tags linked to Substack are assigned/unassigned on the post's Substack copy when you save.

= form.text_field :published_at, value: @post.published_at&.strftime('%Y-%m-%d %H:%M:%S'), data: {'cms-datetime' => true}

= form.check_box :is_published

= form.form_actions do
  = submit_tag t(@post.new_record?? ".create" : ".update"), class: "btn btn-primary ml-sm-1", data: {disable_with: false}
  = link_to 'View', @post.url, class: "btn btn-secondary"
  = link_to t(".cancel"), comfy_admin_blog_posts_path(@site, @blog), class: "btn btn-link"
