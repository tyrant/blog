.page-header
  %h2 Reply Tracker

%section.mb-4
  %h5 Log a reply
  %p.text-muted.small Paste your reply's URL — the post/comment you replied to, its owner, and the timestamp are all looked up automatically.
  = form_with url: comfy_admin_reply_tracker_log_path, method: :post, class: "form-inline" do
    = text_field_tag :comment_url, nil, class: "form-control mr-2", placeholder: "https://…/comment/… or a note URL", style: "width: 34rem;"
    = submit_tag "Log reply", class: "btn btn-primary"

%section
  %h5 Who I reply to
  = form_with url: comfy_admin_reply_tracker_path, method: :get, class: "form-inline mb-3" do
    = text_field_tag :q, params[:q], placeholder: "search usernames", class: "form-control mr-2", style: "width: 18rem;"
    = submit_tag "Search", class: "btn btn-secondary btn-sm"
    - if params[:q].present?
      = link_to "clear", comfy_admin_reply_tracker_path, class: "btn btn-link btn-sm"
  - if @authors.empty?
    %p.text-muted= params[:q].present? ? "No replies match “#{params[:q]}”." : "No replies logged yet."
  - else
    = comfy_paginate @authors
    - @authors.each do |handle, replies|
      .card.mb-3
        .card-body
          %h6.mb-2
            = replies.first.author_name.presence || handle
            %span.text-muted.small= " · #{handle == "(unknown)" ? handle : "@#{handle}"} · #{pluralize(replies.size, 'reply')}"
          %ul.list-unstyled.small.mb-0
            - SubstackReply.threaded(replies).each do |reply, depth|
              %li.mb-1.d-flex.justify-content-between.align-items-start{ style: ("margin-left: #{depth * 1.5}rem; border-left: 2px solid #eee; padding-left: .5rem" if depth.positive?) }
                %span
                  - if depth.positive?
                    %span.text-muted ↳
                  %span.text-muted= l(reply.replied_at, format: :short)
                  = " · "
                  = link_to truncate(reply.target_preview.presence || "target", length: 50), reply.target_url, target: "_blank"
                  →
                  = link_to truncate(reply.reply_preview.presence || "your reply", length: 50), reply.comment_url, target: "_blank"
                = link_to comfy_admin_reply_tracker_delete_path(reply), method: :delete, data: { confirm: "Delete this logged reply?" }, class: "text-danger ml-2", title: "Delete" do
                  %i.fas.fa-times
    = comfy_paginate @authors
