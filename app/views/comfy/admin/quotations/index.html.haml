.page-header
  %h2 Quotations

- editing = @quotation.persisted?
%section.mb-4
  %h5= editing ? "Edit quotation" : "Add a quotation"
  %p.text-muted.small Paste a Substack comment URL and a blurb from it — the post and commenter are looked up automatically.
  = form_with url: (editing ? comfy_admin_quotation_path(@quotation) : comfy_admin_quotations_path), method: (editing ? :patch : :post) do
    = hidden_field_tag :page, @quotations.current_page
    = hidden_field_tag :q, @search if @search.present?
    .form-group
      = text_field_tag :comment_url, @quotation.comment_url, class: "form-control", placeholder: "https://…/comment/… or a note URL"
    .form-group
      = text_area_tag :quotation, @quotation.quotation, class: "form-control", rows: 3, placeholder: "the blurb to quote"
    - if editing
      %p.text-muted.small.mb-1
        The post URL is auto-filled from the comment — set it by hand when the comment is on a
        third-party note whose post can't be resolved. Its title and image are read from Substack
        on save, so they can't be edited here.
      .form-group
        %label.small.text-muted{ for: "post_url" } Post URL
        = text_field_tag :post_url, @quotation.post_url, class: "form-control", placeholder: "https://…/p/…"
      .form-group
        %label.small.text-muted Post title
        %p.form-control-plaintext.mb-0= @quotation.post_title.presence || "— filled from Substack on save —"
      .form-group
        %label.small.text-muted Post image
        - if @quotation.post_image_url.present?
          %div
            = image_tag @quotation.post_image_url, class: "rounded", style: "height: 3rem; width: 3rem; object-fit: cover; object-position: center;"
            %span.text-muted.small.ml-2= @quotation.post_image_url
        - else
          %p.form-control-plaintext.mb-0.text-muted — filled from Substack on save —
      .form-group.form-check
        = check_box_tag :previewable, "1", @quotation.previewable, class: "form-check-input"
        %label.form-check-label{ for: "previewable" } Previewable — reads fine on its own; eligible for the widget above every Substack post
    = submit_tag(editing ? "Update quotation" : "Save quotation", class: "btn btn-primary")
    - if editing
      = link_to "Cancel", comfy_admin_quotations_path(page: @quotations.current_page, q: @search.presence), class: "btn btn-link"

%section.mb-4
  %h5 Reviews pages
  %p.text-muted.small
    Every quotation is mirrored to the dedicated Substack "Reviews" pages, in the order
    below, one page per group. Sync a page to push its quotations to its Substack draft;
    "Changed" marks pages whose quotations were added, edited, deleted or reordered since
    their last sync. Substack wants a 2FA sign-in to publish, so open the draft and click
    Update afterwards — "Needs publishing" clears on reload once Substack shows it published.
    Set page 1's draft id under
    = succeed "." do
      = link_to "Substack Sync settings", edit_comfy_admin_substack_sync_config_path
  %table.table.table-sm.mb-2{ style: "width: auto;" }
    %tbody
      - @reviews_pages.each do |page|
        %tr
          %td.align-middle.pr-3
            = button_to "Sync page #{page[:number]}", comfy_sync_reviews_admin_quotations_path(page: page[:number]),
                        method: :post, class: "btn btn-outline-secondary btn-sm"
          %td.align-middle.small.text-muted.pr-3= pluralize(page[:size], "quotation")
          %td.align-middle.small.pr-3
            - if page[:draft_url]
              = link_to "Open draft", page[:draft_url], target: "_blank"
            - else
              %span.text-muted Created on first sync
          %td.align-middle
            - if page[:changed] == :never
              %span.badge.badge-secondary Not synced yet
            - elsif page[:changed]
              %span.badge.badge-warning Changed
            - if page[:pending]
              %span.badge.badge-info Needs publishing

  = form_with url: comfy_page_size_admin_quotations_path, method: :patch, class: "form-inline mt-2" do
    %label.small.text-muted.mr-2{ for: "reviews_page_size" } Quotations per Reviews page
    = number_field_tag :reviews_page_size, @page_size, min: 1, class: "form-control form-control-sm mr-2", style: "width: 5rem;"
    = submit_tag "Save", class: "btn btn-outline-secondary btn-sm"

%section.mb-4
  %h5 Search quotations
  = form_with url: comfy_admin_quotations_path, method: :get, class: "form-inline" do
    = search_field_tag :q, @search, placeholder: "quotation, post title or author", class: "form-control mr-2", style: "width: 22rem;"
    = submit_tag "Search", name: nil, class: "btn btn-outline-secondary"
    - if @search.present?
      = link_to "Clear", comfy_admin_quotations_path, class: "btn btn-link"

- searching = @search.present?
%section
  - if searching
    %h5= "#{pluralize(@quotations.total_count, 'quotation')} matching “#{@search}”"
  - else
    %h5= "#{pluralize(@quotations.total_count, 'quotation')} collected"
  - if @quotations.empty?
    %p.text-muted= searching ? "No quotations match." : "No quotations yet."
  - elsif searching
    %p.text-muted.small
      Numbers are each quotation's place in the full order. Clear the search to drag and reorder.
  - else
    %p.text-muted.small
      Drag the handle to reorder — this is the order the Reviews pages use. Dividers mark
      the groups of #{@page_size} that become each Substack Reviews page. To move a quotation
      to another page, drop it on "Previous page" (it becomes that page's last) or "Next page"
      (it becomes that page's first).
  - unless @quotations.empty?
    :css
      #quotation-sortable > li[data-reviews-break]::after {
        content: attr(data-reviews-break);
        display: block;
        text-align: center;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #adb5bd;
        border-top: 1px solid #dee2e6;
        margin-top: 1rem;
        padding-top: 0.6rem;
      }
      #quotation-sortable.dragging > li::after { display: none; }
      .quotation-drop-zone {
        border: 2px dashed #dee2e6;
        border-radius: 0.25rem;
        color: #adb5bd;
        text-align: center;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.9rem;
        margin-bottom: 1rem;
        transition: border-color 0.15s, color 0.15s, background-color 0.15s;
      }
      .quotation-drop-zone > span { pointer-events: none; }
      body.quotation-dragging .quotation-drop-zone { border-color: #007bff; color: #007bff; }
      .quotation-drop-zone.drop-hover { background-color: #e7f1ff; }
    - offset = (@quotations.current_page - 1) * @quotations.limit_value
    = comfy_paginate @quotations
    - unless searching || @quotations.first_page?
      %div.quotation-drop-zone{ data: { drop_to: offset - 1 } }
        %span ↑ Previous page — drop here to make it page #{@quotations.current_page - 1}'s last
    %ul.list-unstyled#quotation-sortable{ data: { reorder_url: (comfy_reorder_admin_quotations_path unless searching), offset: offset,
                                                  total: @quotations.total_count, reviews_page_size: @page_size } }
      - @quotations.each_with_index do |q, i|
        - number = searching ? @order_numbers[q.id] : offset + i + 1
        - reviews_break = "Reviews page #{number / @page_size + 1}" if !searching && (number % @page_size).zero? && number < @quotations.total_count
        %li.mb-3{ data: { id: q.id, reviews_break: reviews_break } }
          .d-flex.align-items-start
            - unless searching
              %span.dragger.text-muted.mr-2{ style: "cursor: move; padding-top: 0.2rem;", title: "Drag to reorder" }
                %i.fas.fa-grip-vertical
            %span.order-number.badge.badge-light.mr-2{ style: "padding-top: 0.35rem;" }= number
            - if q.post_image_url.present?
              = image_tag q.post_image_url, class: "mr-2 rounded", style: "height: 3rem; width: 3rem; object-fit: cover; object-position: center; flex-shrink: 0;"
            .flex-grow-1
              %blockquote.mb-1{ style: "font-style: italic;" }= "“#{q.quotation}”"
              - if q.previewable?
                %span.badge.badge-info.mr-2{ title: "Eligible for the widget above every Substack post" } Previewable
              %span.text-muted.small
                By
                - author_name = q.substack_user&.name.presence || "commenter"
                = author_name
                = render "comfy/admin/substack_users/links", user: q.substack_user
              %br
              %span.text-muted.small
                On
                = q.post_url.present? ? link_to(q.post_title.presence || "the post", q.post_url, target: "_blank") : q.post_title
                ·
                = link_to "comment", q.comment_url, target: "_blank"
              - if q.notes.present?
                %br
                %span.text-muted.small
                  #{pluralize(q.notes.size, 'repost')}:
                  = blizzard_note_links(q.notes)
              = render "comfy/admin/substack_blizzard/copy_and_record_form",
                entry: { "text" => q.quotation, "body_json" => Substack::Blizzard::QuotationNote.build(q) },
                categorization_id: nil, uid: nil, quotation_id: q.id, days: nil, page: nil, q: nil, regenerate_url: nil
            .text-nowrap.ml-2
              = link_to comfy_edit_admin_quotation_path(q, page: @quotations.current_page, q: @search.presence), class: "text-secondary mr-2", title: "Edit" do
                %i.fas.fa-pencil-alt
              = link_to comfy_admin_quotation_path(q, page: @quotations.current_page, q: @search.presence), method: :delete, data: { confirm: "Delete this quotation?" }, class: "text-danger", title: "Delete" do
                %i.fas.fa-times
    - unless searching || @quotations.last_page?
      %div.quotation-drop-zone{ data: { drop_to: offset + @quotations.limit_value } }
        %span ↓ Next page — drop here to make it page #{@quotations.current_page + 1}'s first
    = comfy_paginate @quotations
