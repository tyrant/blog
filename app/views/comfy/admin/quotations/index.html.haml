.page-header
  %h2 Quotations

- editing = @quotation.persisted?
%section.mb-4
  %h5= editing ? "Edit quotation" : "Add a quotation"
  %p.text-muted.small Paste a Substack comment URL and a blurb from it — the post and commenter are looked up automatically.
  = form_with url: (editing ? comfy_admin_quotation_path(@quotation) : comfy_admin_quotations_path), method: (editing ? :patch : :post) do
    .form-group
      = text_field_tag :comment_url, @quotation.comment_url, class: "form-control", placeholder: "https://…/comment/… or a note URL"
    .form-group
      = text_area_tag :quotation, @quotation.quotation, class: "form-control", rows: 3, placeholder: "the blurb to quote"
    - if editing
      %p.text-muted.small.mb-1
        Post title/URL are auto-filled from the comment. Set them by hand when the comment
        is on a third-party note whose post can't be resolved (they stand unless you change the comment URL above).
      .form-group
        %label.small.text-muted{ for: "post_title" } Post title
        = text_field_tag :post_title, @quotation.post_title, class: "form-control", placeholder: "post title"
      .form-group
        %label.small.text-muted{ for: "post_url" } Post URL
        = text_field_tag :post_url, @quotation.post_url, class: "form-control", placeholder: "https://…/p/…"
      .form-group
        %label.small.text-muted{ for: "post_image_url" } Post image URL (fallback thumbnail)
        = text_field_tag :post_image_url, @quotation.post_image_url, class: "form-control", placeholder: "https://…cover image…"
    = submit_tag(editing ? "Update quotation" : "Save quotation", class: "btn btn-primary")
    - if editing
      = link_to "Cancel", comfy_admin_quotations_path, class: "btn btn-link"

%section.mb-4
  %h5 Reviews page
  %p.text-muted.small
    Every quotation is mirrored to the dedicated Substack "Reviews" pages. They rebuild
    automatically whenever a quotation is added, edited or deleted (keeping the current order).
    This button reshuffles their order at random and rebuilds. Set the page's draft id under
    = succeed "." do
      = link_to "Substack Sync settings", edit_comfy_admin_substack_sync_config_path
  = button_to "Reshuffle & rebuild Reviews pages", comfy_sync_reviews_admin_quotations_path, method: :post, class: "btn btn-outline-secondary btn-sm"

%section
  %h5= "#{pluralize(@quotations.total_count, 'quotation')} collected"
  - if @quotations.empty?
    %p.text-muted No quotations yet.
  - else
    = comfy_paginate @quotations
    %ul.list-unstyled
      - @quotations.each do |q|
        %li.mb-3.d-flex.justify-content-between.align-items-start
          %div
            %blockquote.mb-1{ style: "font-style: italic;" }= "“#{q.quotation}”"
            %span.text-muted.small
              By
              = q.author_url.present? ? link_to(q.author_name.presence || "commenter", q.author_url, target: "_blank") : (q.author_name.presence || "commenter")
            %br
            %span.text-muted.small
              On
              = q.post_url.present? ? link_to(q.post_title.presence || "the post", q.post_url, target: "_blank") : q.post_title
              ·
              = link_to "comment", q.comment_url, target: "_blank"
          .text-nowrap.ml-2
            = link_to comfy_edit_admin_quotation_path(q), class: "text-secondary mr-2", title: "Edit" do
              %i.fas.fa-pencil-alt
            = link_to comfy_admin_quotation_path(q), method: :delete, data: { confirm: "Delete this quotation?" }, class: "text-danger", title: "Delete" do
              %i.fas.fa-times
    = comfy_paginate @quotations
