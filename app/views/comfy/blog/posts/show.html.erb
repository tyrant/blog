<% 
  @show_other_books = true 
  @only_paid_books = true
%>

<% content_for :title do %>
  The Sexyverse PRESENTS: <%= @cms_post.title %>
<% end %>

<% content_for :banner do %>
  <div class="title-bg" 
       style="background-image: url(<%= image_path @cms_post.resized_blob_or_orig_or_placeholder_url %>)">
    <div class="transparency">

      <h1 class="sub text-outlined">
        <%= @cms_post.title %>
      </h1>
      <p class="text-md text-cyan-100 text-center font-bold">
        <%= @cms_post.published_at.strftime('%e %b %Y') %>
      </p>
    </div>
  </div>
<% end %>

<div class="flex flex-col lg:flex-row gap-24 m-4">

  <div class="grow">
    <div class="post-body prose prose-lg max-w-none leading-snug">
      <%= @cms_post.content_cache.html_safe %>
    </div>

    <%= render ConsentIsSexyYoComponent.new(mode: 'row', nsfw_options: @nsfw_options) %>

    <div class="mb-3">
      <turbo-frame id="prev_nek" 
                  src="<%= prev_nek_path(@cms_post) %>" 
                  target="_top">
      </turbo-frame>
    </div>
  </div>

  <div class="w-72 flex-none flex flex-col gap-6 mt-4 lg:mt-0">
    <% @yearly_random_posts.each do |post| %>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-2 px-1">
          best of <%= post.published_at.year %>
        </h3>
        <%= render PostComponent.new(post: post, cms_site: @cms_site, nsfw_options: @nsfw_options, show_text: false) %>
      </div>
    <% end %>
  </div>

</div>

