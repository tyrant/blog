<% content_for :title do %>
  The Sexyverse PRESENTS: <%= @cms_post.title %>
<% end %>

<% content_for :banner do %>
  <div class="relative w-full h-56 md:h-72 bg-cover bg-center" 
       style="background-image: url(<%= image_path @cms_post.resized_blob_or_orig_or_placeholder_url %>)">
    <div class="flex flex-col justify-center gap-3 bg-cyan-900/40 w-full h-full">

      <h1 class="text-2xl md:text-4xl text-cyan-100 text-center px-12 leading-[1.5rem] md:leading-[2rem] font-['Racing_Sans_One']">
        <%= @cms_post.title %>
      </h1>
      <p class="text-sm text-cyan-100 text-center font-bold">
        <%= @cms_post.published_at.strftime('%e %b %Y') %>
      </p>
    </div>
  </div>
<% end %>

<div class="flex flex-col lg:flex-row-reverse justify-evenly my-6">

  <div class="lg:basis-1/4">
    <%= render ConsentIsSexyYoComponent.new nsfw_options: @nsfw_options %>
  </div>

  <div class="lg:basis-3/4 post-body prose leading-snug">
    <%= @cms_post.content_cache.html_safe %>
  </div>
</div>

<% content_for :footer do %>
  <turbo-frame id="prev_nek" src="<%= prev_nek_path(@cms_post) %>" target="_top">
    <%= 
      render PrevNekComponent.with_collection(
        [nil, *@cms_post.categories.public_names.nsfw_banished(@nsfw_options['banish'])], 
        site: @cms_site,
        post: @cms_post,
        nsfw_options: @nsfw_options
      )
    %>
  </turbo-frame>
<% end %>
