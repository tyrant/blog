<% 
  @show_other_books = true 
  @only_paid_books = true
%>

<% content_for :title do %>
  The Sexyverse PRESENTS: <%= @cms_post.title %>
<% end %>

<% content_for :banner do %>
  <div class="title-bg" 
       style="background-image: url(<%= image_path @cms_post.resized_blob_or_orig_or_placeholder_url %>)">
    <div class="transparency">

      <h1 class="sub text-outlined">
        <%= @cms_post.title %>
      </h1>
      <p class="text-md text-cyan-100 text-center font-bold">
        <%= @cms_post.published_at.strftime('%e %b %Y') %>
      </p>
    </div>
  </div>
<% end %>

<div class="flex flex-col lg:flex-row gap-8 lg:gap-16 my-4 mx-2 xs:mx-6 sm:mx-8 md:mx-12">

  <div class="grow">
    <% if admin_authenticated? %>
      <div class="mb-4 flex justify-start">
        <%= link_to "View in Admin", 
                    edit_comfy_admin_blog_post_path(site_id: @cms_site.id, id: @cms_post.id),
                    class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md shadow-sm transition-colors duration-150",
                    target: "_blank" %>
      </div>
    <% end %>

    <div class="post-body prose prose-lg max-w-none leading-snug">
      <%= @cms_post.content_cache.html_safe %>
    </div>

    <% if @cms_post.substack_url || @cms_post.medium_url %>
      <div class="mt-8 pt-4 border-t border-gray-200 dark:border-gray-700 flex flex-wrap items-center gap-3">
        <span class="text-sm font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">Also read on</span>
        <% if @cms_post.substack_url %>
          <%= link_to "Substack", @cms_post.substack_url, target: "_blank", rel: "noopener noreferrer",
                      class: "inline-flex items-center px-4 py-1.5 rounded-full bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium shadow-sm transition-colors duration-150" %>
        <% end %>
        <% if @cms_post.medium_url %>
          <%= link_to "Medium", @cms_post.medium_url, target: "_blank", rel: "noopener noreferrer",
                      class: "inline-flex items-center px-4 py-1.5 rounded-full bg-gray-800 hover:bg-black text-white text-sm font-medium shadow-sm transition-colors duration-150" %>
        <% end %>
      </div>
    <% end %>

    <%= render ConsentIsSexyYoComponent.new(mode: 'row', nsfw_options: @nsfw_options) %>

    <div class="mb-3">
      <turbo-frame id="prev_nek" 
                  src="<%= prev_nek_path(@cms_post) %>" 
                  target="_top">
      </turbo-frame>
    </div>
  </div>

  <div class="w-auto lg:w-72 flex-none grid grid-cols-1 xs:grid-cols-2 md:grid-cols-3 lg:grid-cols-1 lg:content-start gap-6 mt-4 lg:mt-0">
    <% @yearly_random_posts.each do |post| %>
      <div class="">
        <h3 class="text-sm text-center font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-1 px-1 w-full">
          best of <%= post.published_at.year %>
        </h3>
        <%= render PostComponent.new(post: post, cms_site: @cms_site, nsfw_options: @nsfw_options, show_text: false) %>
      </div>
    <% end %>
  </div>

</div>

