= comfy_admin_partial "comfy/admin/cms/partials/html_footer"

-# Vendor bundle (CodeMirror, Bootstrap, Redactor, etc.) - static, rarely changes
= javascript_include_tag "comfy_vendor", "data-turbolinks-track": "reload"
