!!!
%html{lang: "en"}
  %head
    %title Admin sign-in
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1, shrink-to-fit=no"}
    %meta{name: "robots", content: "noindex"}
    = csrf_meta_tags
    = stylesheet_link_tag "comfy/admin/cms/application", media: "all"
    = javascript_include_tag "admin_passkeys", defer: true
  %body
    .container.py-5{style: "max-width: 28rem;"}
      - flash.each do |_type, message|
        .alert.alert-info= message
      = yield
