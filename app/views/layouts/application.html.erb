<!DOCTYPE html>
<html>
  <head>
    <title>
      <% if content_for? :title %>
        <%= content_for :title %>
      <% else %>
        Mikey Clarke
      <% end %>
    </title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag asset_path('kissy-transparent.png') %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    
    <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Racing+Sans+One">
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/amazon-ember">
    
    <% if Rails.env.production? %>
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXZ5QKDNLC"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-HXZ5QKDNLC');
      </script>
    <% end %>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-100">
    <div class="font-sans <% unless @no_nav %>pt-[3.25rem]<% end %>">
      <%= render NavComponent.new(nav_items: @nav_items) unless @no_nav %>
      <%= render FlashComponent.new(message: flash.notice) %>

      <%= content_for :banner if content_for? :banner %>

      <div class="<%= @wide_bg ? '' : 'container mx-auto' %>">
        <%= yield %>
      </div>
    </div>
  
    <% unless @no_nav %>
      <div class="footer mt-auto">
        <span class="copyright">© Copyright ... idk, 2004? 17.3? We still on the Julian calendar?</span>
        <span class="links">
          <%= link_to landing_index_path do %>
            Read <em>The Knights of Raw Phowar</em> FREE omg
          <% end %>
          <%= link_to "Privacy", privacy_path %>
          <%= link_to 'Contact', contact_path %>
        </span>
      </div>
    <% end %>

    <%= render ModalComponent.new(type: 'irritate') do %>
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4 font-['Racing_Sans_One'] text-center text-white">
        <h1 class="absolute w-[calc(100%-3rem)] top-[15%] text-2xl sm:text-4xl uppercase leading-[1.1rem]">We interrupt this blog</h1>
        <h2 class="absolute top-[32%] w-[calc(100%-3rem)] text-lg sm:text-xl">to annoy you</h2>
        <h2 class="absolute top-[48%] w-[calc(100%-3rem)] text-lg sm:text-xl">and make things</h2>
        <h2 class="absolute top-[62%] w-[calc(100%-3rem)] text-lg sm:text-xl">generally</h2>
        <%= image_tag 'bbc-globe.jpg' %>
        <%= image_tag 'idle-wink-nudge-cropped.jpg' %>
      </div>

      <div class="px-4 sm:px-6
                  pb-4 sm:pb-6
                  flex 
                  justify-center">
        <button class="min-w-fit
                      rounded-md
                      border
                      border-transparent
                      shadow-xl
                      px-4
                      py-2
                      bg-red-800
                      text-base
                      font-medium
                      text-white
                      hover:bg-red-700
                      hover:tracking-widest
                      hover:before:content-['😱']
                      hover:after:content-['😱']
                      hover:focus:before:content-['😱😱']
                      hover:focus:after:content-['😱😱']
                      hover:focus:bg-red-500
                      hover:focus:tracking-[.4em]
                      hover:focus:font-normal
                      focus:outline-none
                      focus:ring-2
                      focus:ring-offset-2
                      focus:ring-red-500
                      focus:tracking-[.5em]
                      focus:before:content-['😱😱😱']
                      focus:after:content-['😱😱😱']
                      focus:uppercase
                      focus:font-bold
                      focus:bg-red-400"
                x-on:click="isOpen=false">
          irritating
        </button>
      </div>
    <% end %>
  </body>
</html>
